NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 32 raw bytes, base64-encoded (generate with: openssl rand -base64 32).
# Used to encrypt cloud provider credentials (e.g. AWS keys) at rest.
CLOUD_CREDENTIALS_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
# Resend API key, used to email support requests. Without it the request is
# still recorded -- only the notification is skipped.
RESEND_API_KEY=re_your_api_key
# Must be an address on a domain verified in Resend, or the send is refused.
SUPPORT_EMAIL_FROM=Cloud Assist One <support@cloudassistone.com>
# Where support requests are delivered. Defaults to mgolino@outlook.com.
SUPPORT_EMAIL_TO=mgolino@outlook.com
# Anthropic API key, used by the Line Items assistant to turn a plain-English
# question into a filter. Get one at console.anthropic.com -> Settings -> API
# Keys; it is billed separately from any Claude.ai subscription. Without it the
# assistant is hidden and every other feature works unchanged.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Stripe secret key. Use a restricted key or a test-mode sk_test_... key
# while developing -- this key can create charges and refunds. Get one at
# dashboard.stripe.com -> Developers -> API keys. Without it, Subscribe and
# Manage billing both fail with "Billing is not set up yet."
STRIPE_SECRET_KEY=sk_test_your_api_key

# One Stripe Price id per paid tier (dashboard.stripe.com -> Product
# catalog -> create a recurring monthly Price for each). The Billing tab
# still shows a Subscribe button for a tier missing one -- clicking it fails
# with a clear "not available for checkout yet" error rather than the
# button silently disappearing.
STRIPE_PRICE_SUBSCRIPTION_4=price_your_subscription_4_price_id
STRIPE_PRICE_SUBSCRIPTION_20=price_your_subscription_20_price_id
STRIPE_PRICE_SUBSCRIPTION_UNLIMITED=price_your_subscription_unlimited_price_id

# Verifies that a webhook request actually came from Stripe. Get this from
# the webhook endpoint's own page in the Stripe dashboard (Developers ->
# Webhooks -> your endpoint -> Signing secret) after pointing it at
# <your-domain>/api/webhooks/stripe and subscribing it to
# customer.subscription.created, customer.subscription.updated, and
# customer.subscription.deleted -- nothing else is read.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
