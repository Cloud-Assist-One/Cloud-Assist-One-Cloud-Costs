NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 32 raw bytes, base64-encoded (generate with: openssl rand -base64 32).
# Used to encrypt cloud provider credentials (e.g. AWS keys) at rest.
CLOUD_CREDENTIALS_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
# Resend API key, used to email support requests. Without it the request is
# still recorded -- only the notification is skipped.
RESEND_API_KEY=re_your_api_key
# Must be an address on a domain verified in Resend, or the send is refused.
SUPPORT_EMAIL_FROM=Cloud Assist One <support@cloudassistone.com>
# Where support requests are delivered. Defaults to mgolino@outlook.com.
SUPPORT_EMAIL_TO=mgolino@outlook.com
# Anthropic API key, used by the Line Items assistant to turn a plain-English
# question into a filter. Get one at console.anthropic.com -> Settings -> API
# Keys; it is billed separately from any Claude.ai subscription. Without it the
# assistant is hidden and every other feature works unchanged.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Stripe secret key, server-side only. Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint. The local value comes from
# `stripe listen`; the production value from the dashboard webhook endpoint.
# They are NOT interchangeable.
STRIPE_WEBHOOK_SECRET=
# Recurring price ids. SUB4 is the $150/mo plan, SUB20 the $250/mo plan.
# No NEXT_PUBLIC_ prefix: nothing in the browser reads these.
STRIPE_PRICE_SUB4=
STRIPE_PRICE_SUB20=
